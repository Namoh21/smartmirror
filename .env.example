# Copy this file to .env and fill in your values.
# The app reads these via os.getenv() in src/config.py

# --- Location ---
SM_LATITUDE=41.8781
SM_LONGITUDE=-87.6298
SM_CITY=Chicago
SM_TIMEZONE=America/Chicago

# --- Google Calendar ---
# Comma-separated; "primary" = the main calendar of the authenticated account
SM_CALENDAR_IDS=primary

# --- News ---
# Replace with an RSS feed URL for your local newspaper / TV station
SM_LOCAL_NEWS_RSS=https://feeds.feedburner.com/chicagotribune/news

# --- Light sensor ---
SM_LIGHT_SENSOR=true
SM_GPIO_PIN=4

# --- Display ---
SM_FULLSCREEN=true
SM_WIDTH=800
SM_HEIGHT=480
